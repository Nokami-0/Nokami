<div class="stth-sheet {{#if vehicle}}vehicle{{/if}}" autocomplete="off">
<header class="stth-header"><img src="{{actor.img}}" data-action="stthAction" data-stth="portrait" title="Portrait"><div><input name="name" value="{{actor.name}}" class="name"><div class="tagline">SONIC TAG-TEAM HEROES <span>1.5.0 rules</span></div>{{#unless vehicle}}<label>Type <select name="system.heroType">{{selectOptions types selected=system.heroType}}</select></label><label>Archetype <select name="system.archetype">{{selectOptions archetypes selected=system.archetype}}</select></label><label>Species <input name="system.species" value="{{system.species}}"></label>{{/unless}}</div></header>
<div class="resources"><label>HP {{#if system.hpNotApplicable}}N/A{{else}}<input type="number" name="system.hp.value" value="{{system.hp.value}}" min="0"> / {{#if vehicle}}<input type="number" name="system.hp.max" value="{{system.hp.max}}">{{else}}{{system.derived.hpMax}}{{/if}}{{/if}}</label>{{#unless vehicle}}<label>TP <input type="number" name="system.tp.value" value="{{system.tp.value}}" min="0" max="15"> / 15</label><label>Rings <input type="number" name="system.rings" value="{{system.rings}}" min="0"></label><label>Mobiums <input type="number" name="system.mobiums" value="{{system.mobiums}}" min="0"></label>{{/unless}}<label>Crits <input type="number" name="system.crits" value="{{system.crits}}" min="0"></label>{{#unless system.hpNotApplicable}}<button type="button" data-action="stthAction" data-stth="damage">Take damage</button>{{/unless}}{{#unless vehicle}}<button type="button" data-action="stthAction" data-stth="rings">Spend Rings</button>{{/unless}}</div>
{{#if hasForms}}<div class="toolbar"><strong>{{formLabel}}</strong><button type="button" data-action="stthAction" data-stth="transform">Transform (Interact)</button><span>Shared HP, Crits and conditions. Track distance already moved this turn.</span></div>{{/if}}
<nav class="tabs"><button type="button" data-action="stthAction" data-stth="tab" data-tab="stats">Stats & Skills</button><button type="button" data-action="stthAction" data-stth="tab" data-tab="abilities">Attacks & Abilities</button><button type="button" data-action="stthAction" data-stth="tab" data-tab="gear">Gear</button><button type="button" data-action="stthAction" data-stth="tab" data-tab="team">Team & Special</button><button type="button" data-action="stthAction" data-stth="tab" data-tab="encounters">Encounters</button><button type="button" data-action="stthAction" data-stth="tab" data-tab="notes">Notes & Rules</button></nav>
<p>Armor DR {{system.derived.damageReduction}}</p><section class="sheet-body">
<div class="tab" data-tab="stats">
{{#if vehicle}}<h2>Vehicle Profile</h2><button type="button" data-action="stthAction" data-stth="vehicleAction">Vehicle Actions / Ride / Repair / Ram</button><div class="grid3"><label>Speed<input type="number" name="system.speed" value="{{system.speed}}"></label><label>Power<input type="number" name="system.power" value="{{system.power}}"></label><label>Dexterity modifier<input type="number" name="system.dexterityModifier" value="{{system.dexterityModifier}}"></label><label>Dodge<input type="number" name="system.dodge" value="{{system.dodge}}" min="0" max="6"></label><label>Movement (squares)<input type="number" name="system.movement" value="{{system.movement}}"></label><label>Passengers<input type="number" name="system.passengers" value="{{system.passengers}}"></label><label>Width (squares)<input type="number" name="system.width" value="{{system.width}}"></label><label>Length (squares)<input type="number" name="system.length" value="{{system.length}}"></label><label>Crit threshold<input type="number" name="system.critThreshold" value="{{system.critThreshold}}"></label></div><label>Pilot Actor UUID<input name="system.pilot" value="{{system.pilot}}" placeholder="Actor.…"></label><label>Crew (names / roles)<textarea name="system.crew">{{system.crew}}</textarea></label><label>Qualities<input name="system.qualities" value="{{system.qualities}}"></label><label>Form factor and mounted placement<textarea name="system.form">{{system.form}}</textarea></label><label>Personal scale <input type="checkbox" name="system.personal" {{checked system.personal}}></label><p>Use pilot Initiative and skills. Dexterity modifier adds/removes Hit Dice on Ride, not character Dexterity. Arcs and turning radius are adjudicated on the grid.</p>
{{else}}
<div class="attribute-row">{{#each attributes}}<section class="attribute-column {{key}}"><label class="attribute {{key}}">{{label}}<input aria-label="{{label}}" type="number" name="system.attributes.{{key}}" value="{{value}}" min="1" max="7"><small>Effective {{effective}}</small></label>{{#each skills}}<div class="skill"><button type="button" data-action="stthAction" data-stth="skill" data-skill="{{key}}">{{key}}</button><input aria-label="{{key}} ranks" type="number" name="system.skills.{{key}}" value="{{ranks}}" min="0" max="4"><small>{{effective}} effective ranks</small></div>{{/each}}</section>{{/each}}</div>
<div class="derived"><button type="button" data-action="stthAction" data-stth="dodge">Dodge {{system.derived.dodge}}</button><span>Initiative {{system.derived.initiative}}</span><span>Move {{system.derived.movement}} squares</span><span>Gear {{system.derived.gearUsed}} / {{system.gearSlots}}</span><label>Height <input type="number" name="system.height" value="{{system.height}}" min="0"></label></div>
<div class="toolbar"><button type="button" data-action="stthAction" data-stth="create">Character creation</button><button type="button" data-action="stthAction" data-stth="advance">Buy advancement</button><button type="button" data-action="stthAction" data-stth="rest">Night’s rest (+5 HP/TP)</button><button type="button" data-action="stthAction" data-stth="adventure">Adventure recovery</button></div>
<details><summary>Permanent bonuses / NPC settings</summary>{{#if npc}}<p>{{system.npcTier}} · {{system.profileSource}}</p><div class="grid3"><label>Printed Dodge<input type="number" name="system.profileDodge" value="{{system.profileDodge}}" min="0" max="6"></label><label>Printed Initiative dice<input type="number" name="system.profileInitiative" value="{{system.profileInitiative}}" min="0"></label><label>Printed Move squares<input type="number" name="system.profileMovement" value="{{system.profileMovement}}" min="0"></label></div>{{/if}}<div class="grid3"><label>Dodge bonus<input type="number" name="system.dodgeBonus" value="{{system.dodgeBonus}}"></label><label>Initiative bonus<input type="number" name="system.initiativeBonus" value="{{system.initiativeBonus}}"></label><label>Movement bonus<input type="number" name="system.movementBonus" value="{{system.movementBonus}}"></label><label>HP bonus<input type="number" name="system.hpBonus" value="{{system.hpBonus}}"></label><label>Gear slots<input type="number" name="system.gearSlots" value="{{system.gearSlots}}"></label><label>Skill Rings spent<input type="number" name="system.advancementSpent" value="{{system.advancementSpent}}"></label><label>Squad size (Henchmen)<input type="number" name="system.squadSize" value="{{system.squadSize}}" min="1" max="5"></label><label>Squad skills (comma separated)<input name="system.squadSkills" value="{{system.squadSkills}}"></label><label>NPC crit threshold<input type="number" name="system.critThreshold" value="{{system.critThreshold}}"></label><label>Initiative Trick Dice upgrades<input type="number" name="system.initiativeTrick" value="{{system.initiativeTrick}}"></label></div><p>For NPC HP values differing from Power×5+5, set HP bonus to the difference. Talents may also supply persistent modifiers.</p></details>
{{/if}}
<p>{{system.profileSource}} {{#if system.initiativeNotApplicable}} · Initiative N/A: GM schedules this hazard.{{/if}}</p>{{#if system.usesPilot}}<label>Pilot Actor UUID<input name="system.pilot" value="{{system.pilot}}" placeholder="Actor.…"></label><p>Default values use {{system.pilotLabel}}. A linked pilot supplies mental attributes and unlisted skills.</p>{{/if}}<h2>Status</h2><div class="conditions">{{#each conditions}}<button type="button" data-action="stthAction" data-stth="condition" data-condition="{{id}}" class="{{#if stacks}}active{{/if}}">{{label}} {{#if stacks}}×{{stacks}}{{/if}}</button>{{/each}}</div>
</div>
<div class="tab" data-tab="abilities">{{#unless vehicle}}<button type="button" data-action="stthAction" data-stth="loadout">Build Signature Attack</button>{{/unless}}{{#each abilityGroups}}<section class="item-group"><h2>{{label}} <button type="button" data-action="stthAction" data-stth="add" data-type="{{type}}">+ Add</button></h2>{{#each items}}<div class="item item-row" data-item-id="{{id}}" draggable="true"><img src="{{img}}"><button type="button" data-action="stthAction" data-stth="edit" class="item-name">{{name}}</button>{{#if system.ammoLimited}}<span>Ammo {{system.quantity}} / {{system.ammoMax}}</span>{{/if}}{{#if templatable}}<span>{{shapeLabel}}</span><button type="button" data-action="stthAction" data-stth="template">Arc / Area</button>{{/if}}{{#if rollable}}<span>Dmg {{damage}}</span><button type="button" data-action="stthAction" data-stth="roll">Roll</button>{{/if}}{{#if gear}}<button type="button" data-action="stthAction" data-stth="equip">{{#if system.equipped}}Unequip{{else}}Equip{{/if}}</button><span>{{system.slots}} slots</span>{{/if}}{{#if consumable}}<span>×{{system.quantity}}</span><button type="button" data-action="stthAction" data-stth="use">Use</button>{{/if}}{{#if system.remainingRecharge}}<button type="button" data-action="stthAction" data-stth="recharge">Recharge ({{system.remainingRecharge}})</button>{{/if}}<button type="button" data-action="stthAction" data-stth="delete" title="Remove item">×</button></div>{{/each}}</section>{{/each}}<p>Drag items from the STTH Library compendium onto this sheet. Signature Attack and Talent slots follow the four-slot rules, independently of the six gear slots.</p></div>
<div class="tab" data-tab="gear">{{#each gearGroups}}<section class="item-group"><h2>{{label}} <button type="button" data-action="stthAction" data-stth="add" data-type="{{type}}">+ Add</button></h2>{{#each items}}<div class="item item-row" data-item-id="{{id}}" draggable="true"><img src="{{img}}"><button type="button" data-action="stthAction" data-stth="edit" class="item-name">{{name}}</button>{{#if system.ammoLimited}}<span>Ammo {{system.quantity}} / {{system.ammoMax}}</span>{{/if}}{{#if templatable}}<span>{{shapeLabel}}</span><button type="button" data-action="stthAction" data-stth="template">Arc / Area</button>{{/if}}{{#if rollable}}<span>Dmg {{damage}}</span><button type="button" data-action="stthAction" data-stth="roll">Roll</button>{{/if}}{{#if gear}}<button type="button" data-action="stthAction" data-stth="equip">{{#if system.equipped}}Unequip{{else}}Equip{{/if}}</button><span>{{system.slots}} slots</span>{{/if}}{{#if consumable}}<span>×{{system.quantity}}</span><button type="button" data-action="stthAction" data-stth="use">Use</button>{{/if}}{{#if system.remainingRecharge}}<button type="button" data-action="stthAction" data-stth="recharge">Recharge ({{system.remainingRecharge}})</button>{{/if}}<button type="button" data-action="stthAction" data-stth="delete" title="Remove item">×</button></div>{{/each}}</section>{{/each}}<p>Weapons, equipment, consumables and vehicle upgrades. Use Roll to attack with a weapon.</p></div>
<div class="tab" data-tab="team">{{#unless vehicle}}<h2>Team Blast</h2><label>Name component<input name="system.blastName" value="{{system.blastName}}"></label><label>Blast skill<select name="system.blastSkill">{{selectOptions skillChoices selected=system.blastSkill}}</select></label><label>Speed status<input name="system.blastStatus" value="{{system.blastStatus}}"></label><label>Speed team buff<input name="system.blastBuff" value="{{system.blastBuff}}" placeholder="rings / sneakers / barrier"></label><button type="button" data-action="stthAction" data-stth="blast">Team Blast (GM)</button>{{#if technique}}<h2>Technique Special</h2><label>Special skill<select name="system.specialSkill">{{selectOptions skillChoices selected=system.specialSkill}}</select></label><label>Used this session<input type="checkbox" name="system.specialUsed" {{checked system.specialUsed}}></label><button type="button" data-action="stthAction" data-stth="special">Use Special</button><button type="button" data-action="stthAction" data-stth="session">Reset session use</button><p>Genius: Inventive Solution; Figurehead: Rally Support; Generalist: Indomitable Will. Failed skill attempts can be retried in a later encounter, not repeatedly in the same encounter.</p>{{/if}}{{/unless}}</div>
<div class="tab" data-tab="encounters"><h2>Turn Phases</h2><p>One Move, one Interact, one Action in any order. Spend Action for another Move or Interact. Movement cannot be banked between phases.</p><div class="toolbar"><button type="button" data-action="stthAction" data-stth="phase" data-phase="move">Move</button><button type="button" data-action="stthAction" data-stth="phase" data-phase="interact">Interact</button><button type="button" data-action="stthAction" data-stth="phase" data-phase="action">Action</button><button type="button" data-action="stthAction" data-stth="exchange">Exchange Action</button><button type="button" data-action="stthAction" data-stth="resetPhases">Reset phases</button></div><p>Recorded: Move {{system.phases.move}} · Interact {{system.phases.interact}} · Action {{system.phases.action}}</p>{{#unless vehicle}}<h2>Challenges</h2><div class="toolbar"><button type="button" data-action="stthAction" data-stth="zone">Zone check</button><button type="button" data-action="stthAction" data-stth="race">Race step</button><button type="button" data-action="stthAction" data-stth="qte">QTE check</button><button type="button" data-action="stthAction" data-stth="resetQte">Reset QTE</button></div><p>QTE successes {{system.qte.success}} / failures {{system.qte.failure}}. Race Speed {{system.race.speed}}, progress {{system.race.progress}}.</p><h2>Underwater & Shields</h2><label>Underwater<input type="checkbox" name="system.underwater" {{checked system.underwater}}></label><label>Shield<input name="system.shield" value="{{system.shield}}" placeholder="barrier / thunder / flame / aqua"></label><label>Sneakers rounds remaining<input type="number" name="system.sneakersRounds" value="{{system.sneakersRounds}}" min="0"></label><button type="button" data-action="stthAction" data-stth="breath">Submerged interval</button><button type="button" data-action="stthAction" data-stth="surface">Air / surface</button><button type="button" data-action="stthAction" data-stth="end">End encounter</button>{{/unless}}</div>
<div class="tab" data-tab="notes"><button type="button" data-action="stthAction" data-stth="rules">Open quick reference</button><h2>Description</h2><textarea name="system.bio" rows="15">{{system.bio}}</textarea>{{#unless vehicle}}<label>Appearance<textarea name="system.appearance">{{system.appearance}}</textarea></label><label>Personality<textarea name="system.personality">{{system.personality}}</textarea></label>{{/unless}}<p>Original game: McShmoodle. Rulebook v1.5.0. This is an unofficial fan conversion. Sheet styling follows the STTH character sheet and rulebook. Consult your PDF for full examples.</p></div>
</section></div>
