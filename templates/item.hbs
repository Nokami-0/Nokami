<div class="stth-sheet" autocomplete="off"><header class="stth-header"><img src="{{item.img}}" data-action="editPortrait"><input class="name" name="name" value="{{item.name}}"></header><p>{{item.type}}</p><label>Description / full rules<textarea rows="9" name="system.description">{{system.description}}</textarea></label><label>Source<input name="system.source" value="{{system.source}}"></label><details open><summary>Attack / Ability</summary><div class="grid3"><label>Skill<select name="system.skill">{{selectOptions skills selected=system.skill}}</select></label><label>Damage mode<select name="system.damageMode">{{selectOptions damageModes selected=system.damageMode}}</select></label><label>Damage / additive bonus<input type="number" name="system.damage" value="{{system.damage}}"></label><label>Range (squares)<input type="number" name="system.range" value="{{system.range}}"></label><label>Net Advantage<input type="number" name="system.advantage" value="{{system.advantage}}"></label><label>Damage per extra hit<input type="number" name="system.extraDamage" value="{{system.extraDamage}}"></label><label>Effect<input name="system.effect" value="{{system.effect}}"></label><label>Hits to activate effect<input type="number" name="system.effectHits" value="{{system.effectHits}}"></label><label>AoE<input name="system.aoe" value="{{system.aoe}}"></label><label>Arc<input name="system.arc" value="{{system.arc}}"></label><label>Facing<input name="system.facing" value="{{system.facing}}"></label><label>Movement cost<input name="system.movementCost" value="{{system.movementCost}}"></label><label>Interact recharge<input type="number" name="system.recharge" value="{{system.recharge}}"></label><label>Recharge remaining<input type="number" name="system.remainingRecharge" value="{{system.remainingRecharge}}"></label><label>Limited ammunition<input type="checkbox" name="system.ammoLimited" {{checked system.ammoLimited}}></label><label>Status only (no damage)<input type="checkbox" name="system.statusOnly" {{checked system.statusOnly}}></label><label>TP cost<input type="number" name="system.tpCost" value="{{system.tpCost}}"></label><label>Aim skill<select name="system.aimSkill">{{selectOptions skills selected=system.aimSkill}}</select></label><label>Partner skill<select name="system.partnerSkill">{{selectOptions skills selected=system.partnerSkill}}</select></label><label>Required partner Type<input name="system.partnerType" value="{{system.partnerType}}"></label><label>Combo kind<input name="system.comboKind" value="{{system.comboKind}}"></label></div></details><details open><summary>Gear / inventory / passive modifiers</summary><div class="grid3"><label>Equipped<input type="checkbox" name="system.equipped" {{checked system.equipped}}></label><label>Removable<input type="checkbox" name="system.removable" {{checked system.removable}}></label><label>Disabled<input type="checkbox" name="system.disabled" {{checked system.disabled}}></label><label>Broken<input type="checkbox" name="system.broken" {{checked system.broken}}></label><label>Slots<input type="number" name="system.slots" value="{{system.slots}}"></label><label>Quantity<input type="number" name="system.quantity" value="{{system.quantity}}"></label><label>Mobium price<input type="number" name="system.price" value="{{system.price}}"></label><label>Ring price<input type="number" name="system.ringPrice" value="{{system.ringPrice}}"></label><label>Modifier<select name="system.modifier">{{selectOptions modifiers selected=system.modifier}}</select></label><label>Modifier target (attribute/skill/status)<input name="system.modifierTarget" value="{{system.modifierTarget}}"></label><label>Modifier value<input type="number" name="system.modifierValue" value="{{system.modifierValue}}"></label><label>Subtype / consumable effect<input name="system.subtype" value="{{system.subtype}}"></label><label>Gear kind (unique category)<input name="system.gearKind" value="{{system.gearKind}}"></label></div></details><label>Notes<textarea name="system.notes">{{system.notes}}</textarea></label></div>
