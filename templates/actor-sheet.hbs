<style>
  /* FONTES NINJA / ANIME */
  @import url('https://fonts.googleapis.com/css2?family=Kaushan+Script&family=Yusei+Magic&family=Marcellus&display=swap');

  /* ESTILOS GERAIS DA FICHA */
  .shinobi.sheet.actor {
    min-width: 0;
    min-height: 0;
  }
  
  .shinobi-wrapper {
    background: #e6dfcf;
    background-image: 
      radial-gradient(circle at 100% 50%, rgba(0,0,0,0.05) 0%, transparent 50%),
      radial-gradient(circle at 0% 0%, rgba(200, 180, 150, 0.4) 0%, transparent 40%);
    background-size: cover;
    background-position: center;
    background-blend-mode: multiply;
    padding: 20px;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    font-family: 'Marcellus', serif;
    color: #332b22;
  }

  .jp-text { font-family: 'Yusei Magic', sans-serif; }
  .title-font { font-family: 'Kaushan Script', cursive; }

  /* CABEÇALHO SUPERIOR (TÍTULO) */
  .top-title-area {
    display: flex;
    align-items: flex-end;
    margin-bottom: 10px;
  }
  .top-title-area .logo-placeholder {
    width: 60px; height: 60px;
    background: url('icons/svg/combat.svg') no-repeat center center;
    background-size: contain;
    opacity: 0.7;
    margin-right: 15px;
  }
  .top-title-area h1 {
    font-family: 'Kaushan Script', cursive;
    font-size: 42px;
    margin: 0; border: none;
    line-height: 1;
    color: #1a1510;
    text-shadow: 1px 1px 2px rgba(255,255,255,0.5);
  }
  .top-title-area .jp-sub {
    font-size: 16px;
    color: #665c4d;
    margin-left: 10px;
    letter-spacing: 2px;
  }

  /* ÁREA DE DADOS DO PERSONAGEM (CABEÇALHO) */
  .header-grid-area {
    display: flex;
    gap: 20px;
    margin-bottom: 15px;
  }
  .profile-section {
    position: relative;
    width: 160px; height: 160px;
    border: 3px solid #4a3e30;
    box-shadow: 3px 3px 8px rgba(0,0,0,0.3);
    background: #000;
  }
  .profile-section img {
    width: 100%; height: 100%; object-fit: cover; border: none;
  }
  .profile-section .vertical-tag {
    position: absolute;
    left: -25px; top: 10px;
    background: #e6dfcf;
    border: 1px solid #4a3e30;
    padding: 10px 5px;
    writing-mode: vertical-rl;
    text-orientation: upright;
    font-family: 'Yusei Magic', sans-serif;
    font-size: 20px;
    font-weight: bold;
    box-shadow: -2px 2px 5px rgba(0,0,0,0.2);
  }

  .dados-box {
    flex: 1;
    background: rgba(245, 240, 230, 0.6);
    border: 1px solid #a89f91;
    border-radius: 2px;
    padding: 10px 15px;
    position: relative;
    box-shadow: inset 0 0 10px rgba(0,0,0,0.05);
  }
  .dados-box::after {
    content: "";
    position: absolute; right: 10px; top: 50%;
    transform: translateY(-50%);
    font-size: 120px; color: rgba(0,0,0,0.03);
    pointer-events: none;
  }

  .dados-box .dados-title {
    font-size: 12px; font-weight: bold; color: #5a4f40;
    border-bottom: 1px solid #a89f91; padding-bottom: 2px; margin-bottom: 8px;
    display: flex; justify-content: space-between;
  }
  
  .dados-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px 15px;
  }
  .dados-grid .campo { display: flex; flex-direction: column; }
  .dados-grid .campo.span-3 { grid-column: span 3; }
  .dados-grid label { font-size: 10px; color: #665c4d; font-weight: bold; letter-spacing: 0.5px; }
  .dados-grid input {
    background: transparent; border: none; border-bottom: 1px solid #b8b0a1;
    font-family: 'Marcellus', serif; font-size: 14px; color: #1a1510;
    padding: 2px 0; border-radius: 0;
  }
  .dados-grid input:focus { outline: none; border-bottom: 2px solid #5a4f40; }
  
  .nc-box {
    text-align: center;
  }
  .nc-box input {
    width: 60px; height: 40px; font-size: 24px; font-weight: bold;
    text-align: center; background: #dcd3c1; border: 1px solid #a89f91;
    border-radius: 5px; color: #4a3e30; margin-top: 5px;
  }

  /* MENU DE NAVEGAÇÃO */
  .sns-nav {
    display: flex; gap: 5px; margin-bottom: 15px;
    border-bottom: 2px solid #5a4f40; padding-bottom: 2px;
  }
  .sns-nav .item {
    background: rgba(230, 223, 207, 0.8);
    border: 1px solid #a89f91; border-bottom: none;
    border-radius: 5px 5px 0 0; padding: 6px 15px;
    font-weight: bold; font-size: 12px; color: #4a3e30;
    cursor: pointer; display: flex; align-items: center; gap: 5px;
    transition: 0.2s;
  }
  .sns-nav .item:hover { background: #f0eadd; }
  .sns-nav .item.active { background: #5a4f40; color: #fff; }
  .sns-nav .item .jp { font-family: 'Yusei Magic'; font-size: 16px; font-weight: normal; }

  /* CORPO PRINCIPAL E CAIXAS */
  .sheet-body { flex: 1; overflow-y: auto; overflow-x: hidden; padding-right: 5px; }
  .sns-box {
    background: rgba(245, 240, 230, 0.7);
    border: 1px solid #a89f91;
    border-radius: 3px; padding: 12px; margin-bottom: 12px;
    box-shadow: 1px 1px 4px rgba(0,0,0,0.1);
    position: relative; overflow: hidden;
  }
  .sns-box h3 {
    margin: 0 0 10px 0; padding-bottom: 5px;
    border-bottom: 1px solid #a89f91;
    font-size: 15px; font-weight: bold; color: #332b22;
    display: flex; justify-content: space-between; align-items: center;
  }
  .sns-box h3 i { margin-right: 5px; opacity: 0.7; }

  /* CAIXAS ESPECÍFICAS DE ENERGIA */
  .energia-box { display: flex; flex-direction: column; align-items: center; padding: 10px; border-radius: 5px; position: relative; }
  .energia-box.vit { background: rgba(250, 230, 230, 0.8); border: 1px solid #c78b8b; }
  .energia-box.vit h3 { border: none; color: #a13d3d; font-size: 16px; margin-bottom: 5px; }
  .energia-box.chk { background: rgba(230, 240, 250, 0.8); border: 1px solid #8baac7; }
  .energia-box.chk h3 { border: none; color: #3d6ba1; font-size: 16px; margin-bottom: 5px; }
  .energia-box.jashin { background: rgba(240, 230, 250, 0.8); border: 1px solid #a98bc7; }
  .energia-box.jashin h3 { border: none; font-family: 'Kaushan Script'; font-size: 20px; margin-bottom: 5px; }
  
  .energia-inputs { display: flex; align-items: center; gap: 10px; font-size: 18px; font-weight: bold; }
  .energia-inputs label { font-size: 10px; color: #665c4d; }
  .energia-inputs input { width: 50px; height: 35px; text-align: center; font-size: 18px; font-weight: bold; background: rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.1); border-radius: 3px; }

  /* TABELAS */
  table.sns-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  table.sns-table th { text-align: left; padding: 5px; color: #665c4d; font-size: 10px; border-bottom: 1px solid #c0b7a6; }
  table.sns-table td { padding: 4px 5px; border-bottom: 1px dashed #dcd3c1; }
  table.sns-table tr:last-child td { border-bottom: none; }
  
  .attr-input { width: 35px; text-align: center; font-size: 14px; font-weight: bold; background: transparent; border: 1px solid #b8b0a1; border-radius: 3px; }
  .attr-input.error { border: 2px solid red; background: #ffe6e6; }
  .attr-readonly { width: 35px; text-align: center; font-size: 14px; background: transparent; border: none; color: #5a4f40; }
  
  .icon-cell { width: 20px; text-align: center; font-size: 14px; opacity: 0.7; }
  .quote-box { margin-top: auto; padding: 15px; font-family: 'Kaushan Script'; font-size: 18px; text-align: center; color: #5a4f40; line-height: 1.3; }

  /* ESTATISTICAS DE COMBATE */
  .estatisticas-table input, .estatisticas-table select {
    background: rgba(0,0,0,0.03); border: 1px solid #b8b0a1; border-radius: 3px; padding: 3px; font-family: 'Marcellus';
  }
  .estatisticas-table .total-box {
    background: #dcd3c1; font-weight: bold; font-size: 16px; border: none; width: 40px; text-align: center;
  }

/* Screenshot-matched dark crimson theme; original fields, tabs and mechanics retained. */
.shinobi.sheet.actor {min-width: 720px; min-height: 520px; background: #09080d !important; color: #e8e5e8 !important;}
.shinobi.sheet.actor .window-content {background: #09080d !important; padding: 0 !important; color: #e8e5e8 !important;}
.shinobi.sheet.actor .shinobi-wrapper {background: #09080d !important; background-image: none !important; color: #e8e5e8 !important; padding: 10px !important;}
.shinobi.sheet.actor .top-title-area {border-bottom: 1px solid #9d383c; padding-bottom: 9px; margin-bottom: 7px;}
.shinobi.sheet.actor .top-title-area h1 {color: #c34d51 !important; text-shadow: 0 0 2px #481a20 !important;}
.shinobi.sheet.actor .jp-sub {color: #8e888d !important;}
.shinobi.sheet.actor .logo-placeholder {display:none !important;}
.shinobi.sheet.actor .profile-section {border: 1px solid #3a3037 !important; background:#0a090e !important; box-shadow:none !important; flex-shrink:0;}
.shinobi.sheet.actor .profile-section .vertical-tag {background:#2b0e13 !important; color:#e7b5b7 !important; border-color:#5b2229 !important;}
