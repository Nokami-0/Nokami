.shinobi.sheet.actor .sns-nav {border-bottom:2px solid #a63a41 !important; gap:5px !important;}
.shinobi.sheet.actor .sns-nav .item, .shinobi.sheet.actor .sheet-tabs[data-group=secundario] .item {background:#17151c !important; border:1px solid #383038 !important; color:#d4cbd0 !important; border-radius:2px 2px 0 0 !important;}
.shinobi.sheet.actor .sns-nav .item.active, .shinobi.sheet.actor .sheet-tabs[data-group=secundario] .item.active {background:#b13d44 !important; border-color:#b13d44 !important; color:#fff !important;}
.shinobi.sheet.actor .sns-nav .item:hover, .shinobi.sheet.actor .sheet-tabs[data-group=secundario] .item:hover {background:#69252c !important; color:#fff !important;}
.shinobi.sheet.actor .sheet-body {background:#09080d !important;}
.shinobi.sheet.actor .sns-table {color:#e3dce1 !important;}
.shinobi.sheet.actor .sns-table th {background:#1a0d12 !important; border-bottom:1px solid #9e3c44 !important;}
.shinobi.sheet.actor .sns-table td {border-bottom:1px solid #2d252c !important;}
.shinobi.sheet.actor .sns-table tr:nth-child(even) {background:#252329 !important;}
.shinobi.sheet.actor .sns-table a, .shinobi.sheet.actor a.rollable {color:#e7e1e5 !important;}
.shinobi.sheet.actor .energia-box.vit {background:#160d12 !important; border-color:#8e323c !important;}
.shinobi.sheet.actor .energia-box.chk {background:#0b1018 !important; border-color:#274b6d !important;}
.shinobi.sheet.actor .energia-box.jashin {background:#170f1c !important; border-color:#654278 !important;}
.shinobi.sheet.actor .energia-box.vit h3 {color:#ce535e !important;}
.shinobi.sheet.actor .energia-box.chk h3 {color:#4b9bdb !important;}
.shinobi.sheet.actor .energia-box.jashin h3 {color:#a78cc4 !important;}
