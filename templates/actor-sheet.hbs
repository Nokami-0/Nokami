.shinobi.sheet.actor .quote-box {color:#bf6a70 !important;}
.shinobi.sheet.actor .item-create, .shinobi.sheet.actor button {color:#eee !important;}
.shinobi.sheet.actor .item-create {background:#17141a !important; border:1px solid #5c4148 !important; padding:2px 6px !important;}
.shinobi.sheet.actor .sns-box [style*="background: rgba"] {background:#101017 !important;}
@media(max-width: 1000px) {.shinobi.sheet.actor .dados-grid {grid-template-columns:repeat(3,minmax(0,1fr)) !important;} .shinobi.sheet.actor .sns-nav {flex-wrap:wrap !important;} .shinobi.sheet.actor .header-grid-area {gap:12px !important;} }
@media(max-width: 760px) {.shinobi.sheet.actor .header-grid-area {flex-wrap:wrap !important;} .shinobi.sheet.actor .dados-grid {grid-template-columns:repeat(2,minmax(0,1fr)) !important;} .shinobi.sheet.actor .profile-section {width:110px !important;height:110px !important;} }


  /* Responsive sizing only; keep the screenshot's crimson/black palette and layout. */
  .shinobi.sheet.actor { max-width: 100vw; max-height: 100vh; }
  .shinobi.sheet.actor .window-content { min-width: 0; min-height: 0; overflow: hidden; }
  .shinobi.sheet.actor .shinobi-wrapper { min-width: 0; min-height: 0; overflow: hidden; }
  .shinobi.sheet.actor .sheet-body { min-width: 0; min-height: 0; overflow: auto; }
  .shinobi.sheet.actor .sns-nav { overflow-x: auto; flex-wrap: nowrap; min-width: 0; scrollbar-width: thin; }
  .shinobi.sheet.actor .sns-nav .item { flex: 0 0 auto; white-space: nowrap; }
  .shinobi.sheet.actor .header-grid-area { min-width: 0; }
  .shinobi.sheet.actor .dados-box { min-width: 0; }
  .shinobi.sheet.actor .dados-grid { min-width: 0; }
  .shinobi.sheet.actor .sns-table { min-width: 440px; }
  @media (max-width: 760px) {
    .shinobi.sheet.actor .shinobi-wrapper { padding: 10px; }
    .shinobi.sheet.actor .header-grid-area { gap: 8px; align-items: flex-start; }
    .shinobi.sheet.actor .profile-section { width: 86px; height: 86px; flex: 0 0 86px; }
    .shinobi.sheet.actor .dados-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .shinobi.sheet.actor .dados-grid .campo.span-3 { grid-column: span 2; }
    .shinobi.sheet.actor .top-title-area h1 { font-size: clamp(22px, 6vw, 42px); }
    .shinobi.sheet.actor .sns-nav .item { padding: 6px 9px; }
  }
  @media (max-width: 560px) {
    .shinobi.sheet.actor .header-grid-area { flex-wrap: wrap; }
    .shinobi.sheet.actor .dados-box { flex: 1 1 100%; }
    .shinobi.sheet.actor .sns-box { overflow-x: auto; }
  }

/* Screenshot-matched, monochrome Foundry iconography */
.shinobi.sheet.actor .sns-nav .item i,
.shinobi.sheet.actor .sheet-tabs .item i {font-size: 12px; margin-right: 5px; opacity: .9; vertical-align: middle;}
.shinobi.sheet.actor .sns-box h3 i,
.shinobi.sheet.actor .energia-box h3 i {font-size: 14px; margin-right: 7px; opacity: .85;}
.shinobi.sheet.actor .icon-cell i {font-size: 13px; opacity: .75;}
.shinobi.sheet.actor .item-edit i,
.shinobi.sheet.actor .item-delete i {font-size: 12px; opacity: .85;}

/* Unified screenshot-matched iconography; keeps sheet layout responsive. */
.shinobi-wrapper .fas, .shinobi-wrapper .far, .shinobi-wrapper .fab {font-style:normal;display:inline-block;vertical-align:middle;line-height:1;min-width:1em;text-align:center;}
.shinobi-wrapper .icon-cell {width:26px;min-width:26px;text-align:center;}
.shinobi-wrapper .icon-cell i {font-size:15px;opacity:.94;color:#e6e6e6;}
.shinobi-wrapper .sns-nav .item i {font-size:15px;margin-right:5px;}
.shinobi-wrapper .sns-box h3 i {margin-right:7px;}
.shinobi-wrapper .energia-box.vit h3 i {color:#ef4249;}
.shinobi-wrapper .energia-box.chk h3 i {color:#28aafa;}


/* Screenshot-matched Vitality and Chakra icons, independent of Font Awesome */
.sns-resource-symbol { width: 1.35em; height: 1.35em; display: inline-block; vertical-align: -0.24em; margin-right: .22em; flex: 0 0 auto; }
.sns-vitality-symbol { filter: drop-shadow(0 0 3px rgba(237,38,59,.35)); }
.sns-chakra-symbol { filter: drop-shadow(0 0 3px rgba(36,184,255,.35)); }
/* Ensure every tab, long inventory and sheet section is reachable. */
.shinobi.sheet.actor .window-content {overflow: auto !important; min-height: 0;}
.shinobi.sheet.actor form, .shinobi.sheet.actor .shinobi-wrapper {min-height:0; max-height:100%;}
.shinobi.sheet.actor .sheet-body {overflow-y:auto !important; overflow-x:auto !important; min-height:0; scrollbar-width:thin;}
.shinobi.sheet.actor .tab {overflow-y:auto; min-height:0;}
.shinobi.sheet.actor .sns-box {max-width:100%;}
</style>

<form class="{{cssClass}} shinobi-wrapper" autocomplete="off">
  
  <!-- === TOPO: NOME E SUBTÍTULO === -->
  <div class="top-title-area">
    <div class="logo-placeholder"></div>
    <div>
      <h1>{{actor.name}}</h1>
      <div class="jp-sub">千手 ネトラマ <span style="font-family: 'Marcellus'; font-size: 12px; margin-left: 10px; opacity: 0.7;">(Click 'Sheet' to edit the name)</span></div>
    </div>
  </div>

  <!-- === CABEÇALHO: IMAGEM E DADOS === -->
  <header class="header-grid-area">
    <div class="profile-section">
      <img src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
      <div class="vertical-tag">忍者</div>
    </div>
    
    <div class="dados-box">
      <div class="dados-title">
        <span>CHARACTER INFORMATION</span>
        <span style="font-weight: normal; margin-right: 70px;">NC</span>
      </div>
      <div style="display: flex; gap: 15px;">
        <div class="dados-grid" style="flex: 1;">
          <div class="campo span-3"><label>NAME</label><input name="name" type="text" value="{{actor.name}}"/></div>
          <div class="campo"><label>GENDER</label><input name="system.cabecalho.genero" type="text" value="{{system.cabecalho.genero}}"/></div>
          
          <div class="campo"><label>CLAN | HIJUTSU</label><input name="system.cabecalho.cla" type="text" value="{{system.cabecalho.cla}}"/></div>
          <div class="campo"><label>RANK</label><input name="system.cabecalho.patente" type="text" value="{{system.cabecalho.patente}}"/></div>
          <div class="campo"><label>CURRENT AFFILIATION</label><input name="system.cabecalho.filiacao" type="text" value="{{system.cabecalho.filiacao}}"/></div>
          
          <div class="campo"><label>ALIGNMENT</label><input name="system.cabecalho.tendencia" type="text" value="{{system.cabecalho.tendencia}}"/></div>
          <div class="campo"><label>AGE</label><input name="system.cabecalho.idade" type="text" value="{{system.cabecalho.idade}}"/></div>
          <div class="campo"><label>BIRTHPLACE</label><input name="system.cabecalho.localNascimento" type="text" value="{{system.cabecalho.localNascimento}}"/></div>
          <div class="campo"><label>SEXUALITY</label><input name="system.cabecalho.sexualidade" type="text" value="{{system.cabecalho.sexualidade}}"/></div>
        </div>
        <div class="nc-box">
          <input name="system.cabecalho.nc" type="number" value="{{system.cabecalho.nc}}" data-dtype="Number"/>
        </div>
      </div>
    </div>
  </header>

  <!-- === NAVEGAÇÃO === -->
  <nav class="sns-nav sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="principal"><i class="fas fa-user" aria-hidden="true"></i> <span class="jp">基本</span> MAIN</a>
    <a class="item" data-tab="inventario"><i class="fas fa-toolbox" aria-hidden="true"></i> <span class="jp">道具</span> INVENTORY</a>
    <a class="item" data-tab="poderes"><i class="fas fa-scroll" aria-hidden="true"></i> <span class="jp">術</span> POWERS</a>
    <a class="item" data-tab="databook"><i class="fas fa-book" aria-hidden="true"></i> <span class="jp">書物</span> DATABOOK</a>
    <a class="item" data-tab="configuracoes"><i class="fas fa-cog" aria-hidden="true"></i> <span class="jp">設定</span> SETTINGS</a>
  </nav>

  <!-- === CORPO DA FICHA === -->
  <section class="sheet-body">
    
    <!-- ================= ABA PRINCIPAL ================= -->
    <div class="tab principal" data-group="primary" data-tab="principal">
      <div style="display: flex; flex-direction: column; height: 100%;">
        
        <nav class="sheet-tabs tabs" data-group="secundario" style="flex: 0 0 auto; display: flex; gap: 5px; margin-bottom: 10px; border-bottom: 2px solid #5a4f40; padding-bottom: 5px;">
          <a class="item" data-tab="status" style="font-weight: bold; cursor: pointer; padding: 5px 15px; background: rgba(245,240,230,0.7); border: 1px solid #a89f91; border-radius: 5px 5px 0 0; color: #4a3e30;"><i class="fas fa-chart-bar" aria-hidden="true"></i> STATS & COMBAT</a>
          <a class="item" data-tab="pericias" style="font-weight: bold; cursor: pointer; padding: 5px 15px; background: rgba(245,240,230,0.7); border: 1px solid #a89f91; border-radius: 5px 5px 0 0; color: #4a3e30;"><i class="fas fa-theater-masks" aria-hidden="true"></i> SKILLS & ABILITIES</a>
        </nav>

        <section class="principal-body" style="flex: 1;">
          
          <!-- SUB-ABA: STATUS -->
          <div class="tab status" data-group="secundario" data-tab="status">
            <div style="display: flex; gap: 15px; flex-wrap: wrap;">
              
              <!-- COLUNA ESQUERDA -->
              <div style="flex: 0 0 320px; display: flex; flex-direction: column;">
                
