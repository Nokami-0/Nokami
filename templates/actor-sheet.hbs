    <div class="tab inventario" data-group="primary" data-tab="inventario">
      <div class="sns-box">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px;padding:10px;border:1px solid #b8a678;border-radius:6px;background:rgba(217,185,103,.13)">
          <label for="sns-ryo-balance" style="font-weight:bold"><i class="fas fa-coins"></i> RYO BALANCE (両)</label>
          <input id="sns-ryo-balance" type="number" min="0" step="1" name="system.ryo" value="{{system.ryo}}" style="width:140px;text-align:right" title="Current Ryo held by this character"/>
          <span title="Sum of quantity × item value">Inventory value: <strong>{{inventoryValueRyo}} Ryo</strong></span>
        </div>
        <div style="border:1px solid #b8a678;padding:10px;margin-bottom:10px;border-radius:6px">
          <strong><i class="fas fa-shield-alt"></i> Equipped Armor:</strong> {{#if equippedArmor}}{{equippedArmor.name}}{{else}}None{{/if}}
          <span style="margin-left:10px">Body Hardness bonus: +{{armorHardnessBonus}}</span>
          <span style="margin-left:10px">Armor Absorption: {{armorAbsorptionRemaining}} / {{armorAbsorptionMax}}</span>
          <button type="button" class="sns-armor-damage" style="width:auto;margin:5px">Take Damage</button>
          {{#if equippedArmor}}<button type="button" class="sns-armor-repair" style="width:auto;margin:5px" title="GM only">Restore Armor Absorption (GM)</button>{{/if}}
          <small style="display:block">Only one armor can be equipped. Hardness is included in the defense total. Armor Absorption is spent, then character Absorption reduces remaining damage, before the selected Vitality or Chakra resource when using Take Damage. Armor penalties and special exceptions are listed on the item and may require GM adjudication.</small>
        </div>
        <h3><i class="fas fa-briefcase" aria-hidden="true"></i> EQUIPMENT <a class="item-create" data-type="equipamento" style="cursor: pointer; font-size: 12px; background: rgba(0,0,0,0.1); padding: 2px 5px; border-radius: 3px;">+ Add Item</a></h3>
        <table class="sns-table" style="text-align: center;">
          <thead><tr><th style="text-align: left;">ITEM NAME</th><th style="width: 60px;">QTY</th><th style="width: 60px;">SLOTS</th><th style="width: 90px;">VALUE (RYO)</th><th style="width: 150px;">ACTIONS</th></tr></thead>
          <tbody>
            {{#each equipamentos as |item|}}
            <tr class="item-row" data-item-id="{{item.id}}">
              <td style="font-weight:bold;text-align:left;cursor:pointer" class="item-to-chat" title="Send item to chat"><img src="{{item.img}}" style="width:24px;height:24px;vertical-align:middle;margin-right:8px;border-radius:3px"/>{{item.name}}</td>
              <td>{{item.system.quantidade}}</td>
              <td title="Total occupied slots for this stack">{{item.slotsUsed}}</td><td title="Value per unit: {{item.system.valorRyo}} Ryo">{{item.system.valorRyo}}</td>
              <td>
                <a class="weapon-attack" title="Calculate weapon damage" style="cursor:pointer;margin-right:8px"><i class="fas fa-dice-d20"></i></a>
                <button type="button" class="weapon-equip" data-item-id="{{item.id}}" aria-pressed="{{#if item.system.equipped}}true{{else}}false{{/if}}" title="{{#if item.system.equipped}}Unequip{{else}}Equip{{/if}} {{item.name}}" style="width:auto;display:inline-flex;align-items:center;gap:4px;margin-right:6px;padding:2px 5px;font-size:11px;line-height:16px">{{#if item.system.equipped}}<i class="fas fa-check-circle"></i> Unequip{{else}}<i class="far fa-circle"></i> Equip{{/if}}</button>
                {{#if item.system.consumable}}<a class="sns-consume-item" title="Use one item"><i class="fas fa-flask"></i></a>{{/if}} <a class="item-edit" title="Edit" style="cursor:pointer;margin-right:10px"><i class="fas fa-edit"></i></a>
                <a class="item-delete" title="Delete" style="cursor:pointer"><i class="fas fa-trash"></i></a>
              </td>
            </tr>
            {{/each}}

          </tbody>
          <tfoot>
            <tr>
              <td colspan="3" style="font-weight: bold; text-align: right; padding-top: 15px;">INVENTORY SLOTS (USED / MAX):</td>
              <td colspan="2" style="font-weight: bold; font-size: 18px; padding-top: 15px; color: {{#if compartimentosExcedidos}}#a13d3d{{else}}#3d6ba1{{/if}};">{{compartimentosUsados}} / {{compartimentosMaximos}}</td>
            </tr>
          </tfoot>
        </table>
        <p><strong>Slot calculation:</strong> Base {{compartimentosBase}} + Added {{slotsAdded}} − Removed {{slotsRemoved}} = Maximum {{compartimentosMaximos}}. Used {{compartimentosUsados}}; Available {{compartimentosDisponiveis}}.</p>
        <p><small>Stack slot usage = ceil(quantity / units per slot) × item slot cost. Slot modifiers add or remove capacity.</small></p>
        <p>Equipment encumbrance beyond 3 occupied slots: -{{encumbranceMovementPenalty}} m movement, -{{encumbranceAccuracyPenalty}} accuracy. Apply these penalties manually during combat.</p>
      </div>
    </div>

