              <label><input type="checkbox" name="system.configuracoes.formaBijuu" {{checked system.configuracoes.formaBijuu}}> Bijuu Form (+3 Hardness)</label>
              <label><input type="checkbox" name="system.configuracoes.predadorAquatico" {{checked system.configuracoes.predadorAquatico}}> Aquatic Predator (+ Hardness from VIG)</label>
              <label><input type="checkbox" name="system.configuracoes.resiliencia" {{checked system.configuracoes.resiliencia}}> Resilience (+Hardness, -Movement, -Dodge)</label>
              <label><input type="checkbox" name="system.configuracoes.resistenciaInsaciavel" {{checked system.configuracoes.resistenciaInsaciavel}}> Insatiable Endurance (+ Hardness from VIG)</label>
              <label><input type="checkbox" name="system.configuracoes.rinnegan" {{checked system.configuracoes.rinnegan}}> Rinnegan (-10% Chakra)</label>
              <label><input type="checkbox" name="system.configuracoes.sharinganEsquiva" {{checked system.configuracoes.sharinganEsquiva}}> Sharingan (Dodge = Read Movement)</label>
              <label><input type="checkbox" name="system.configuracoes.shykakyu" {{checked system.configuracoes.shykakyu}}> Shykakyu (+1 Intimidation, +2 Init.)</label>
            </div>
          </div>
          
          <div style="border: 1px solid #b8b0a1; border-radius: 5px; background: rgba(255,255,255,0.3); padding: 10px;">
            <h3 style="border-bottom: 1px solid #b8b0a1; font-size: 14px;">Extra Resource (Max. 1)</h3>
            <div style="display: flex; gap: 15px; align-items: center;">
              <select name="system.recursoExtra.ativo" style="padding: 3px; border-radius: 3px; border: 1px solid #b8b0a1; background: transparent;">
                <option value="nenhum" {{#if recIsNenhum}}selected{{/if}}>None</option>
                <option value="jashin" {{#if recIsJashin}}selected{{/if}}>Jashin Doll</option>
                <option value="kikaichuu" {{#if recIsKikaichuu}}selected{{/if}}>Kikaichuu (Aburame)</option>
                <option value="kamiArte" {{#if recIsKamiArte}}selected{{/if}}>Kami Points (Art)</option>
                <option value="kamiEsp" {{#if recIsKamiEsp}}selected{{/if}}>Kami Points (Spirit)</option>
                <option value="mangekyou" {{#if recIsMangekyou}}selected{{/if}}>Mangekyou Vision Points</option>
                <option value="kujaku" {{#if recIsKujaku}}selected{{/if}}>Kujaku Health Points</option>
                <option value="suika" {{#if recIsSuika}}selected{{/if}}>Suika Points (Hozuki)</option>
              </select>
              <label>Color (HEX):</label>
              <input type="color" name="system.recursoExtra.cor" value="{{system.recursoExtra.cor}}" style="height: 25px; border: none; padding: 0; background: transparent; cursor: pointer;"/>
            </div>
          </div>

        </div>
      </div>
    </div>

  </section>
</form>