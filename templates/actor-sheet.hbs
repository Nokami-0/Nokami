                <table class="sns-table" style="text-align: center;">
                  <thead><tr><th style="text-align: left;">ABILITY</th><th>TOTAL</th><th>BASE</th><th>PTS</th><th>OTHER</th></tr></thead>
                  <tbody>
                    {{#each listaSociais as |social|}}
                    <tr>
                      <td style="font-weight: bold; text-align: left;"><a class="rollable" data-nome="{{social.nomeAmigavel}}" data-precisao="{{social.dados.total}}" style="cursor: pointer;">{{social.nomeAmigavel}}</a> <span style="font-size: 9px; opacity: 0.7;">({{social.siglaAttr}})</span></td>
                      <td><input type="number" value="{{social.dados.total}}" class="attr-readonly" style="font-weight: bold;" readonly /></td>
                      <td><input type="number" value="{{social.dados.base}}" class="attr-readonly" readonly /></td>
                      <td><input type="number" name="system.periciasSociais.{{social.chave}}.pontos" value="{{social.dados.pontos}}" class="attr-input {{#if social.erroLimite}}error{{/if}}"/></td>
                      <td><input type="number" name="system.periciasSociais.{{social.chave}}.outro" value="{{social.dados.outro}}" class="attr-input"/></td>
                    </tr>
                    {{/each}}
                  </tbody>
                </table>
              </div>

              <!-- GERAIS -->
              <div class="sns-box" style="flex: 1; min-width: 280px;">
                <h3>GENERAL SKILLS <span style="font-size: 11px; font-weight: normal; color: {{#if evolucao.periciasNegativo}}red{{else}}#777{{/if}};">(Remaining: {{evolucao.pericias}})</span></h3>
                <table class="sns-table" style="text-align: center;">
                  <thead><tr><th style="text-align: left;">ABILITY</th><th>TOTAL</th><th>BASE</th><th>PTS</th><th>OTHER</th></tr></thead>
                  <tbody>
                    {{#each listaPericias as |pericia|}}
                    <tr>
                      <td style="font-weight: bold; text-align: left;"><a class="rollable" data-nome="{{pericia.nomeAmigavel}}" data-precisao="{{pericia.dados.total}}" style="cursor: pointer;">{{pericia.nomeAmigavel}}</a> <span style="font-size: 9px; opacity: 0.7;">({{pericia.siglaAttr}})</span></td>
                      <td><input type="number" value="{{pericia.dados.total}}" class="attr-readonly" style="font-weight: bold;" readonly /></td>
                      <td><input type="number" value="{{pericia.dados.base}}" class="attr-readonly" readonly /></td>
                      <td><input type="number" name="system.pericias.{{pericia.chave}}.pontos" value="{{pericia.dados.pontos}}" class="attr-input {{#if pericia.erroLimite}}error{{/if}}" {{#if pericia.isLocked}}readonly style="background: #e0e0e0;" title="Requires enabling 'Chemist'"{{/if}}/></td>
                      <td><input type="number" name="system.pericias.{{pericia.chave}}.outro" value="{{pericia.dados.outro}}" class="attr-input" {{#if pericia.isLocked}}readonly style="background: #e0e0e0;"{{/if}}/></td>
                    </tr>
                    {{#if pericia.showMechanismsRules}}
                    <tr>
                      <td colspan="5" style="text-align: left;">
                        <details>
                          <summary>Mechanics rules</summary>
                          <p>Trained, Intelligence-based skill. Disable, reactivate or sabotage a device. You can rig it to fail after use. Repairs are outside this skill.</p>
                          <p>Operating a mechanism takes 2 turns. Apply −4 to the check without a toolkit.</p>
                          <ul>
                            <li>Difficulty 8 to jam a lock or projectile launcher.</li>
                            <li>Difficulty 12 to sabotage a wagon wheel or drawbridge.</li>
                            <li>Difficulty 16 to disable or reactivate a standard trap.</li>
                            <li>Difficulty 20 to disable or reactivate an advanced trap.</li>
                          </ul>
                          <p>Building a trap requires Engineer, materials, GM approval, 10 minutes and one toolkit use. No construction check is required. You cannot build the trap under pressure.</p>
                          <p>For the Sky Ninja handheld kunai launcher, use Mechanisms to jam the device. Firing uses a normal ranged weapon attack.</p>
                        </details>
                      </td>
                    </tr>
                    {{/if}}
                    {{/each}}
                  </tbody>
                </table>
              </div>

            </div>
