.shinobi.sheet.actor .sns-box h3 {margin:-12px -12px 10px !important;}
.shinobi.sheet.actor .dados-grid label, .shinobi.sheet.actor label, .shinobi.sheet.actor .sns-table th {color:#b4a9b0 !important;}
.shinobi.sheet.actor input:not([type=checkbox]), .shinobi.sheet.actor select, .shinobi.sheet.actor textarea {background:#0a090e !important; color:#eee9ec !important; border:1px solid #44373e !important; border-radius:2px !important; box-shadow:none !important;}
.shinobi.sheet.actor input:focus, .shinobi.sheet.actor textarea:focus {border-color:#c35158 !important; outline:none !important;}
